.data
prompt: .string "Enter a number: "
yesmsg: .string "It is a Hardy-Ramanujan number!\n"
nomsg:  .string "It is NOT a Hardy-Ramanujan number.\n"

.text
.globl main

main:
    # Print prompt
    li a7, 4
    la a0, prompt
    ecall

    # Read integer
    li a7, 5
    ecall
    mv t0, a0        # number stored in t0

    li t6, 0         # count of representations found = 0

    # Outer loop: a from 1..cube_root(n)
    li t1, 1         # a = 1
outer_loop:
    mul t2, t1, t1   # t2 = a^2
    mul t2, t2, t1   # t2 = a^3

    # break if a^3 >= n
    bge t2, t0, check_done

    # Inner loop: b from a..cube_root(n)
    addi t3, t1, 1   # b = a+1
inner_loop:
    mul t4, t3, t3   # t4 = b^2
    mul t4, t4, t3   # t4 = b^3

    add t5, t2, t4   # t5 = a^3 + b^3
    beq t5, t0, found

    blt t5, t0, cont_inner
    j end_inner

cont_inner:
    addi t3, t3, 1
    j inner_loop

end_inner:
    addi t1, t1, 1
    j outer_loop

found:
    addi t6, t6, 1      # count++
    beq t6, x2, done    # if count == 2 -> stop
    j end_inner

check_done:
    # check if count >= 2
    li t1, 2
    blt t6, t1, not_hrn

done:
    # print yesmsg
    li a7, 4
    la a0, yesmsg
    ecall
    j exit

not_hrn:
    li a7, 4
    la a0, nomsg
    ecall

exit:
    li a7, 10
    ecall



