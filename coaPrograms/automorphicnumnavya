.data
prompt: .string "Enter the number: "
res1: .string "Yes the number is automorphic"
res2: .string "No the number is not automorphic"



.text
.global main 

main:

li a7, 4
la a0, prompt
ecall

li a7, 5
ecall


mv t0, a0


mul t1, t0 ,t0
mv t2, t0
li t3, 10
li t4, 1


auto_loop:
beq t2 , x0 , done
div t2, t2, t3
mul t4, t4, t3
j auto_loop

done:

rem t5, t1, t4

beq t5, t0, auto1
j auto2

auto1:
li a7, 4
la a0, res1
ecall
j exit

auto2:
li a7, 4
la a0, res2
ecall


exit:
li a7, 10
ecall
