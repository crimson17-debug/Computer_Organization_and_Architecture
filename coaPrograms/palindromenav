#palindrome
.data
prompt1: .string "Enter the number: "
res1: .string "Yes the number is palindrome"
res2: .string "No the number is not a palindrome"


.text
.global main
main:


li a7, 4	#reads the string
la a0, prompt1
ecall


li a7, 5
ecall


mv t0, a0
mv t1,t0
li t2, 10
li t3, 0

loop:
beq t1, x0, done
rem t4, t1,t2
mul t3, t3, t2
add t3, t3, t4
div t1, t1, t2
j loop

done:
beq t3, t0, result1
j result2

result1:
li a7, 4
la a0, res1
ecall
j exit


result2:
li a7, 4
la a0, res2
ecall


exit:
li a7, 10
ecall