#happy number

.data 
prompt1: .string "Enter the number: "
res1: .string "Happy number"
res2: .string "Unhappy number"

.text
.global main
main:


li a7, 4
la a0, prompt1
ecall

li a7, 5
ecall
 
mv t0, a0
li t1, 10
li t2, 0
li t4, 1
li t5, 4

loop:
beq t0, x0, loop2
rem t3, t0, t1
mul t3, t3, t3
add t2, t2, t3
div t0, t0, t1
j loop

loop2:
beq t2, t4, result1
beq t2, t5, result2
mv t0, t2
li t2, 0
j loop

result1:
li a7, 4
la a0, res1
ecall
j exit

result2:
li a7,4
la a0, res2
ecall

exit:
li a7, 10
ecall
