.data
array: .word 7 5 6 3 4 1 2
size: .word 7
space: .string " "


.text
.global main
main:


la t0, array    #arr
lw s0, size     #n-1

li t1, -1     # i
li t2, 0 	#j


outer_loop:
beq t1, s0, done
addi t1, t1, 1
la t0, array
li t2, 0

inner_loop:
beq t2, s0, outer_loop

lw t3, 0(t0)
lw t4, 4(t0)

bge t3, t4, swap
j next

swap:
sw t4, 0(t0)
sw t3 , 4(t0)

next:
addi t0, t0, 4
addi t2, t2, 1
j inner_loop


done:
li t1, 0
la t0, array

loop:
beq t1, s0, exit

lw t2, 0(t0)
mv a0, t2
li a7, 1
ecall

li a7, 4
la a0, space
ecall

addi t0, t0, 4
addi t1, t1, 1
j loop

exit:
li a7, 10 
ecall

